# Country configuration
REACT_APP_COUNTRY=mozambique

# OpenSPP Integration (optional)
# Base URL for the OpenSPP GIS API (spp_api_v2_gis module)
REACT_APP_OPENSPP_API_URL=https://openspp.example.com/api/v2

# OAuth2 Client Credentials for OpenSPP authentication
# These are used for the Client Credentials flow to obtain a JWT token.
# Note: For public-facing deployments, use a backend proxy instead.
REACT_APP_OPENSPP_CLIENT_ID=your_client_id
REACT_APP_OPENSPP_CLIENT_SECRET=your_client_secret
